{
   "$schema": "https://schema.tauri.app/config/2",
   "productName": "Lil Buddy",
   "version": "0.1.0",
   "identifier": "com.lilbuddy.app",
   "build": {
      "beforeDevCommand": "npm run dev",
      "devUrl": "http://localhost:1437",
      "frontendDist": "../dist"
   },
   "app": {
      "windows": [
         {
            "label": "chat",
            "title": "Lil Buddy",
            "width": 680,
            "height": 760,
            "resizable": true,
            "transparent": true,
            "decorations": false,
            "visible": false,
            "alwaysOnTop": true,
            "shadow": false,
            "minWidth": 680,
            "minHeight": 760
         }
      ],
      "security": {
         "csp": null
      }
   },
   "bundle": {
      "active": true,
      "targets": "all",
      "icon": [
         "icons/32x32.png",
         "icons/128x128.png",
         "icons/128x128@2x.png",
         "icons/icon.icns",
         "icons/icon.ico"
      ]
   }
}
